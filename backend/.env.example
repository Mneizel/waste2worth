# Copy to .env and adjust.
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# Admin endpoints require this key in the `x-admin-key` header.
ADMIN_API_KEY="dev-admin-key-change-me"

# Vision provider: "stub" (deterministic, offline) is the only one for now.
VISION_PROVIDER=stub

# Prefix prepended to media URLs returned by the API. Empty = relative URLs.
MEDIA_BASE_URL=""

# Max accepted upload size for scan photos, in bytes (default 8 MiB).
MAX_UPLOAD_BYTES=8388608

# Directory (relative to backend/) where uploaded scan photos are written.
UPLOAD_DIR="public/uploads"

# CORS allowed origin. "*" allows any.
CORS_ORIGIN="*"

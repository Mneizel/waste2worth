# "local"  = fully in-browser prototype (default, no backend needed)
# "remote" = talk to the real backend API
VITE_API_MODE=local

# Only used when VITE_API_MODE=remote:
VITE_API_BASE_URL=http://localhost:4000

# Real photo recognition (VITE_API_MODE=local only): a free Gemini API key.
# Get one at https://aistudio.google.com/app/apikey (no credit card needed).
# Without this set, the app is honest about not guessing -- it shows
# "ما قدرنا نتعرّف على الجسم" and lets the user pick the size manually,
# instead of faking a recognized category. See README.md "Real photo
# recognition" for the security note on restricting this key.
VITE_GEMINI_API_KEY=
